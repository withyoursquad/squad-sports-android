<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for API calls and real-time SSE -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone for audio messages (Freestyles) and Squad Line voice calls -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera for QR code scanning (invitations) and profile photos -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for active voice calls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Optional: vibrate for notification alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declare camera as optional — SDK works without it -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application>
        <activity
            android:name="com.squadsports.sdk.SquadExperienceActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>

</manifest>
